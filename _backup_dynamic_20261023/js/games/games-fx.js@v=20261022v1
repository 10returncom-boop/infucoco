    el.onclick=()=>{ score++; sc().textContent=score; burst(arena,x,arena.clientHeight-60,'#ffb88a'); floatText(arena,x,arena.clientHeight-70,'+1','#c96a2a'); onScore(score); el.remove(); };
    setTimeout(()=>el.remove(),2700);
  },380);
