/* ============================================================
   g69 打地鼠小怪獸 — 冒頭快打，連擊加倍
   ============================================================ */
G.fx_g69 = function(){ return { start(stage,onScore,onEnd){
  onScore=onScore||function(){}; onEnd=onEnd||function(){};
  const {arena,hp,sc,cb}=hud(stage,'🔨','打地鼠小怪獸','radial-gradient(circle at 50% 30%,#7a5cc8,#3a2f66)');
  arena.innerHTML='<div class="holes" style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:20px;height:100%;align-content:center"></div>';
  const holes=arena.querySelector('.holes'),cells=[];
  for(let i=0;i<9;i++){const c=document.createElement('div');
    c.style.cssText='border-radius:16px;background:rgba(0,0,0,.28);display:grid;place-items:center;font-size:1.9rem;cursor:pointer;transition:background .15s';
    holes.appendChild(c);cells.push(c);}
  let score=0,combo=0,cur=-1,t=null,tries=0;
  function popMole(){ if(cur>=0&&cells[cur]){cells[cur].textContent='';cells[cur].style.background='rgba(0,0,0,.28)';}
    cur=Math.floor(Math.random()*9); cells[cur].textContent='👾'; cells[cur].style.background='rgba(227,107,0,.5)';
    t=setTimeout(()=>{if(cur>=0){cells[cur].textContent='';cells[cur].style.background='rgba(0,0,0,.28)';cur=-1;popMole();}}, Math.max(450,1100-tries*8));
  }
  cells.forEach((c,i)=>c.onclick=()=>{
    if(i!==cur||c.textContent!=='👾'){combo=0;cb().textContent='x1';return;}
    tries++; combo++; const gain=1+Math.floor(combo/3); score+=gain; sc().textContent=score; cb().textContent='x'+combo;
    const r=c.getBoundingClientRect(),ar=arena.getBoundingClientRect();
    burst(arena,r.left-ar.left+40,r.top-ar.top+30); floatText(arena,r.left-ar.left+30,r.top-ar.top+20,'+'+gain,'#ffd34d');
    c.textContent='💫'; c.style.background='#3E9B6F';
    onScore(score); cur=-1; clearTimeout(t);
    if(tries>=25){clearTimeout(t);t=setTimeout(()=>{onEnd(score);gameOver(stage,score);},300);} else popMole();
  });
  popMole();
  stage.closest('.game-stage').__replay=()=>this.start(stage,onScore,onEnd);
}};

/* ============================================================
   g73 幸運轉盤 — conic-gradient 轉盤，抽獎
   ============================================================ */
G.fx_g73 = function(){ return { start(stage,onScore,onEnd){
  onScore=onScore||function(){}; onEnd=onEnd||function(){};
  const {arena,sc}=hud(stage,'🎡','幸運轉盤','linear-gradient(#fff3d6,#ffe0b8)');
  const prizes=[1,2,3,5,0,2,1,4];
  arena.innerHTML=`<div style="position:absolute;inset:0;display:grid;place-items:center">
    <div class="wheel" style="width:220px;height:220px;border-radius:50%;background:conic-gradient(#E36B00 0 45deg,#7A5CC8 45deg 90deg,#3E9B6F 90deg 135deg,#E36B00 135deg 180deg,#7A5CC8 180deg 225deg,#3E9B6F 225deg 270deg,#E36B00 270deg 315deg,#7A5CC8 315deg 360deg);transition:transform 3s cubic-bezier(.2,.8,.2,1)"></div></div>
    <button class="btn o" style="position:absolute;bottom:14px;left:50%;transform:translateX(-50%)">🎡 轉！</button>`;
  const wheel=arena.querySelector('.wheel'),btn=arena.querySelector('.btn'); let rot=0,spins=0,score=0;
  btn.onclick=()=>{btn.disabled=true;rot+=720+Math.random()*360;wheel.style.transform=`rotate(${rot}deg)`;
    setTimeout(()=>{const idx=Math.floor(((rot%360)/45));const win=prizes[idx%8];score+=win;sc().textContent=score;
      burst(arena,arena.clientWidth/2,arena.clientHeight/2, win>2?'#ffd34d':'#ccc'); floatText(arena,arena.clientWidth/2,arena.clientHeight/2,'+'+win, win>2?'#E36B00':'#888');
      onScore(score);btn.disabled=false;spins++;if(spins>=5){onEnd(score);gameOver(stage,score);}},3100);};
  stage.closest('.game-stage').__replay=()=>this.start(stage,onScore,onEnd);
}};

/* ============================================================
   g76 釣魚星之河 — 停在綠區釣大魚
   ============================================================ */
G.fx_g76 = function(){ return { start(stage,onScore,onEnd){
  onScore=onScore||function(){}; onEnd=onEnd||function(){};
  const {arena,sc}=hud(stage,'🎣','釣魚星之河','linear-gradient(#0e1e3f,#1d3a6b)');
  arena.innerHTML=`<div style="position:absolute;top:30px;left:50%;transform:translateX(-50%);font-size:2.4rem">🌌</div>
    <div style="position:absolute;bottom:70px;left:10%;right:10%;height:34px;border-radius:17px;background:rgba(255,255,255,.15)">
      <div style="position:absolute;left:60%;width:22%;height:100%;border-radius:17px;background:#3E9B6F"></div>
      <div class="bob" style="position:absolute;top:-4px;left:0;width:14px;height:42px;border-radius:7px;background:#ffd34d"></div></div>
    <button class="btn o" style="position:absolute;bottom:14px;left:50%;transform:translateX(-50%)">🎣 拉竿！</button>`;
  const bob=arena.querySelector('.bob'),btn=arena.querySelector('.btn');
  let pos=0,dir=1,score=0,tries=0;
  const raf=(t)=>{ pos+=dir*1.6; if(pos>86||pos<0)dir*=-1; bob.style.left=pos+'%'; requestAnimationFrame(raf); };
  requestAnimationFrame(raf);
  btn.onclick=()=>{ tries++; const good=pos>=60&&pos<=82;
    if(good){score+=3;sc().textContent=score;burst(arena,arena.clientWidth/2,120,'#7ec8ff');floatText(arena,arena.clientWidth/2,110,'大魚+3!','#ffd34d');}
    else {score+=1;sc().textContent=score;floatText(arena,arena.clientWidth/2,110,'小魚+1','#9fd0ff');}
    onScore(score); shake(arena);
    if(tries>=10){onEnd(score);gameOver(stage,score);}
  };
  stage.closest('.game-stage').__replay=()=>this.start(stage,onScore,onEnd);
}};

/* ============================================================
   g85 畫一道彩虹 — 拖曳畫布，畫滿完成
   ============================================================ */
G.fx_g85 = function(){ return { start(stage,onScore,onEnd){
  onScore=onScore||function(){}; onEnd=onEnd||function(){};
  const {arena}=hud(stage,'🌈','畫一道彩虹','#eaf6ff');
  arena.innerHTML=`<canvas width="500" height="360" style="width:100%;height:100%;touch-action:none"></canvas>
    <p style="position:absolute;bottom:4px;width:100%;text-align:center;color:#8a8170;font-size:.8rem">拖曳滑鼠，畫出一道彩虹弧</p>`;
  const cv=arena.querySelector('canvas'),ctx=cv.getContext('2d');
  const cols=['#e74c3c','#e67e22','#f1c40f','#2ecc71','#3498db','#9b59b6']; let ci=0,drawing=false,n=0;
  ctx.lineWidth=16; ctx.lineCap='round';
  const pos=e=>{const r=cv.getBoundingClientRect();const cx=(e.touches?e.touches[0].clientX:e.clientX)-r.left;return[cx*(cv.width/r.width),((e.touches?e.touches[0].clientY:e.clientY)-r.top)*(cv.height/r.height)];};
  cv.onpointerdown=e=>{drawing=true;ctx.strokeStyle=cols[ci%cols.length];ctx.beginPath();ctx.moveTo(...pos(e));};
  cv.onpointermove=e=>{ if(!drawing)return; ctx.lineTo(...pos(e)); ctx.stroke(); n++; if(n%6===0){score=Math.min(100,n);onScore(score);} if(n>260){drawing=false;onEnd(100);gameOver(stage,100);} };
  cv.onpointerup=()=>{drawing=false;ci++;};
  stage.closest('.game-stage').__replay=()=>this.start(stage,onScore,onEnd);
}};

